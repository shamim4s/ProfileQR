    ;; p6s2
    ;; =========================================================

    (data (i32.const 448)
        "p6s2"
    )


    ;; =========================================================
    ;; URL CHECK
    ;; =========================================================

    (func (export "check")
        (param $ptr i32)
        (result i32)

        (local $i i32)
        (local $a i32)
        (local $b i32)

        (local.set $i
            (i32.const 0)
        )

        (block $done

            (loop $compare

                (br_if $done
                    (i32.ge_u
                        (local.get $i)
                        (i32.const 32)
                    )
                )

                ;; Input hash
                (local.set $a
                    (i32.load8_u
                        (i32.add
                            (local.get $ptr)
                            (local.get $i)
                        )
                    )
                )

                ;; Stored hash
                (local.set $b
                    (i32.load8_u
                        (local.get $i)
                    )
                )

                ;; Compare
                (if
                    (i32.ne
                        (local.get $a)
                        (local.get $b)
                    )

                    (then
                        (return
                            (i32.const 0)
                        )
                    )
                )

                (local.set $i
                    (i32.add
                        (local.get $i)
                        (i32.const 1)
                    )
                )

                (br $compare)
            )
        )

        ;; MATCH
        (i32.const 1)
    )


    ;; =========================================================
    ;; A1 pointer + length
    ;; =========================================================

    (func (export "A1_ptr")
        (result i32)
        (i32.const 64)
    )

    (func (export "A1_len")
        (result i32)
        (i32.const 13)
    )


